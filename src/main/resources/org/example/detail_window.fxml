<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fx:id="detailImageView" fitHeight="380.0" fitWidth="260.0" layoutX="30.0" layoutY="30.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="30.0" />

        <VBox layoutX="320.0" layoutY="30.0" prefHeight="190.0" spacing="10.0" AnchorPane.leftAnchor="320.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <Label fx:id="titleLabel" text="Media name" textFill="WHITE" wrapText="true">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label fx:id="typeLabel" text="TYPE: FILM" textFill="#4361ee">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Label fx:id="authorLabel" text="Author / Director" textFill="#dddddd">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="genreLabel" text="Genre" textFill="#dddddd">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="yearLabel" text="Year" textFill="#dddddd">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="extraLabel" text="Additional info" textFill="#dddddd">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 5 0 0 0;">
                    <children>
                        <Button fx:id="favoriteButton" mnemonicParsing="false" style="-fx-background-radius: 15; -fx-background-color: #2a2a2a; -fx-text-fill: #ff4757; -fx-font-weight: bold; -fx-cursor: hand;" text="🖤 Add to Favorites" />
                        <Label text="Rating:" textFill="#aaaaaa">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="ratingComboBox" prefWidth="110.0" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-background-radius: 10;" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <Label layoutX="320.0" layoutY="271.0" text="Description:" textFill="#aaaaaa" AnchorPane.leftAnchor="320.0" AnchorPane.topAnchor="271.0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <TextArea fx:id="descriptionArea" editable="false" layoutX="320.0" layoutY="291.0" prefHeight="195.0" style="-fx-control-inner-background: #2a2a2a; -fx-text-fill: white;" wrapText="true" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="320.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="291.0" />

        <Button fx:id="deleteButton" layoutX="6.0" layoutY="457.0" mnemonicParsing="false" style="-fx-background-radius: 15; -fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 12 5 12;" text="🗑️ Delete Item" />
    </children>
</AnchorPane>
