<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AddController">
    <children>
        <Label layoutX="50.0" layoutY="40.0" text="Add New Media to Library">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <ComboBox fx:id="typeComboBox" layoutX="50.0" layoutY="100.0" prefWidth="150.0" promptText="Select Type" />
        <TextField fx:id="titleField" layoutX="50.0" layoutY="150.0" prefWidth="400.0" promptText="Enter Title (AI will fix typos)" />
        <Button layoutX="50.0" layoutY="300.0" mnemonicParsing="false" onAction="#onSaveClick" prefHeight="30.0" prefWidth="100.0" text="Save" />
        <Button layoutX="170.0" layoutY="300.0" mnemonicParsing="false" onAction="#onBackClick" prefHeight="30.0" prefWidth="100.0" text="Back" />
    </children>
</AnchorPane>