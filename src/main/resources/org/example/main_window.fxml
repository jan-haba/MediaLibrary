<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.MainController">
    <children>
        <TextField fx:id="searchField" layoutX="40.0" layoutY="32.0" prefHeight="26.0" prefWidth="520.0" promptText="Search your media..." />
        <ListView fx:id="mediaListView" layoutX="40.0" layoutY="78.0" prefHeight="244.0" prefWidth="520.0" />
        <Button layoutX="40.0" layoutY="341.0" mnemonicParsing="false" onAction="#onAddWindowClick" prefHeight="34.0" prefWidth="130.0" text="Add New Item" />
        <Button layoutX="430.0" layoutY="341.0" mnemonicParsing="false" onAction="#onStatsWindowClick" prefHeight="34.0" prefWidth="130.0" text="View Stats" />
    </children>
</AnchorPane>