<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #1e1e24;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.MainController">
    <children>
        <TextField fx:id="searchField" layoutX="40.0" layoutY="32.0" prefHeight="35.0" promptText="🔍 Search your media by title or genre..." style="-fx-background-radius: 20 0 0 20; -fx-padding: 0 15 0 15; -fx-background-color: #2e2e38; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa;" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="220.0" AnchorPane.topAnchor="30.0" />

        <ComboBox fx:id="filterTypeComboBox" layoutX="580.0" layoutY="30.0" onAction="#onFilterChange" prefHeight="35.0" prefWidth="180.0" style="-fx-background-radius: 0 20 20 0; -fx-background-color: #3b3b46; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="30.0" />

        <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background: #1e1e24; -fx-border-color: #1e1e24;" AnchorPane.bottomAnchor="90.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="90.0">
            <content>
                <TilePane fx:id="mediaTilePane" hgap="20.0" prefColumns="4" prefTileHeight="200.0" prefTileWidth="150.0" style="-fx-background-color: #1e1e24; -fx-alignment: top-left;" vgap="20.0" />
            </content>
        </ScrollPane>

        <Button layoutX="40.0" layoutY="535.0" mnemonicParsing="false" onAction="#onAddWindowClick" prefHeight="40.0" prefWidth="160.0" style="-fx-background-radius: 20; -fx-background-color: #4361ee; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Add New Item" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="40.0" />

        <Button layoutX="600.0" layoutY="535.0" mnemonicParsing="false" onAction="#onStatsWindowClick" prefHeight="40.0" prefWidth="160.0" style="-fx-background-radius: 20; -fx-background-color: #3f37c9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📊 View Stats" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="40.0" />
    </children>
</AnchorPane>