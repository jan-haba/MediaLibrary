<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.StatsController">
    <children>
        <Label layoutX="50.0" layoutY="40.0" text="Your Media Statistics">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <VBox layoutX="50.0" layoutY="100.0" spacing="15.0">
            <children>
                <Label fx:id="movieHoursLabel" text="Total Movie Hours: 0">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <Label fx:id="episodesLabel" text="Total Series Episodes Watched: 0">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <Label fx:id="pagesLabel" text="Total Book Pages Read: 0">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <Label fx:id="musicTracksLabel" text="Total Music Tracks: 0">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
        </VBox>
        <Button layoutX="50.0" layoutY="320.0" mnemonicParsing="false" onAction="#onBackClick" prefHeight="30.0" prefWidth="120.0" text="Back to Library" />
    </children>
</AnchorPane>